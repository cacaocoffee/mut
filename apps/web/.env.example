# MUT 웹 환경변수 — 이 파일을 `.env.local` 로 복사해 쓴다.
#
# 셋뿐이다. 하나씩 없을 때 무슨 일이 생기는지 적어 둔다 — 셋 다 없어도 화면은
# 멀쩡해 보이기 때문에, 모르면 잘못된 것이 배포된다.
#
# 배포 단계별로 무엇을 넣는지는 ADR-0007 에 있다 (docs/decisions/ADR-0007-hosting.md).


# ── 사이트 절대 주소 ────────────────────────────────────────────────────────
# 배포에는 **반드시 넣는다.** 1단계(웹만)에도 필요하다.
#
# 없으면 http://localhost:3000 을 쓴다 (apps/web/lib/site.ts). 그러면 OG · 사이트맵 ·
# 구조화 데이터가 전부 로컬을 가리켜서 **카카오톡 카드가 뜨지 않는다** (NFR-S-06).
# 화면은 아무 이상이 없어 보이므로 눈으로는 못 잡는다.
#
# 끝의 슬래시는 붙이든 말든 상관없다 — site.ts 가 떼어 낸다.
MUT_SITE_URL=https://mut.example.com


# ── API 주소 ───────────────────────────────────────────────────────────────
# **1단계에서는 비워 둔다.** 비우면 packages/domain 의 배열로 빌드한다
# (apps/web/lib/api.ts). 백엔드 없이 탐색 · 파인더 · 내 술장 · 재료 사전이 전부 돈다.
#
# 대신 **서버를 부르는 것은 안 돈다** — 검색(/api/search) · 로그인 · 어드민.
# 2단계에서 Fly 주소를 넣으면 그 순간부터 API 만 쓴다.
#
# MUT_API_URL=https://api.mut.example.com


# ── 발행 재생성 시크릿 ──────────────────────────────────────────────────────
# 어드민이 발행할 때 API 가 POST /api/revalidate 를 부르며 X-Revalidate-Secret 에 담는다.
# 양쪽에 같은 값을 넣는다.
#
# 없으면 그 경로가 503 으로 닫힌다 — 열어 두면 누구나 재생성을 부를 수 있어서 그렇다.
# 1단계에는 부르는 쪽(어드민)이 없으므로 안 넣어도 된다.
#
# NEXT_PUBLIC_ 접두를 **붙이지 않는다.** 붙이면 클라이언트 번들에 실려 나간다.
#
# REVALIDATE_SECRET=
