{
  "name": "k-cocktail-archive",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @kca/web",
    "build": "npm run build --workspace @kca/web",
    "start": "npm run start --workspace @kca/web",
    "lint": "npm run lint --workspace @kca/web",
    "typecheck": "tsc -p apps/web --noEmit",
    "check": "npm run check --workspace @kca/domain && node scripts/taxonomy-parity.mjs && node scripts/css-guard.mjs && node scripts/color-parity.mjs && node scripts/contrast-check.mjs",
    "verify": "npm run check && npm run contract:check && npm run lint && npm run build",
    "generate:types": "node scripts/generate-types.mjs",
    "contract:check": "node scripts/generate-types.mjs --check",
    "facet:parity": "tsx scripts/facet-parity.ts",
    "e2e": "npm run e2e --workspace @kca/web"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.8",
    "typescript": "^5"
  }
}
