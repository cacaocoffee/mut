# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- 모노레포 (apps/* · packages/*) ---
# 위 루트 전용 패턴(/node_modules, /.next/)은 중첩 경로를 잡지 못한다
node_modules/
.next/
out/
dist/

# Kotlin/Gradle (apps/api — SPEC-05 §2)
.gradle/
# Kotlin 2.x 세션 디렉터리 (gitignore 는 줄 끝 주석을 패턴의 일부로 읽는다)
.kotlin/
build/
!src/**/build/
*.class

# AI 에이전트 운영 아티팩트
.omc/
.claude/settings.local.json

# IDE
.idea/
*.iml
.vscode/

# Gradle (apps/api) — 모노레포 패턴이 이미 .gradle/ build/ 를 잡지만 wrapper 는 커밋한다
!apps/api/gradle/wrapper/gradle-wrapper.jar
!apps/api/gradlew

# Playwright (ISSUE-056)
apps/web/playwright-report/
apps/web/test-results/

# 에이전트 워크트리 — 로컬 작업 공간이다. 임베디드 리포로 커밋되면 안 된다
.claude/worktrees/
